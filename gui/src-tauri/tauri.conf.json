{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dovetail",
  "identifier": "dev.dovetail.app",
  "build": {
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "Dovetail", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:* http://localhost:*" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
